expression 'Groups - ORC Proposal Viewer' = ```
		/* ---------------------------------------------------------------------------------------------------------
		   The result is:
		    The Groups that has XXX Roles and XXX Roles have Permission which its name contains ORC_Proposal
		
		    Query here: 
		    1) Get all the Groups
		    2) Filtered Role ID by the result of the "Roles - ORC Proposal Viewer" query (Role ID List - ORC Proposal Viewer (ref)
		------------------------------------------------------------------------------------------------------------*/
		let
		    Source = Sql.Database("dbsqlazprd.database.windows.net", "Authorization", [Query="SELECT g._id 'Group ID', g.name 'Group Name', g.description 'Group Description', r._id 'Role ID' FROM GroupRoles gr LEFT JOIN Groups g on gr.GroupId = g._id LEFT JOIN Role r on gr.RoleId = r._id ORDER by 'Group Name'"]),
		    #"Filtered Rows" = Table.SelectRows(Source, each List.Contains(#"Role ID List - ORC Proposal Viewer (ref)", [Role ID]))
		in
		    #"Filtered Rows"
		```
