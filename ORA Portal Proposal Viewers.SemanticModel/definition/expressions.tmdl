expression 'Groups - Title Viewer' = ```
		let
		    Source = Sql.Database("dbsqlazprd.database.windows.net", "Authorization", [Query="
		        SELECT t1.[Group Name], t2.[Title Viewer] FROM
		        (
		            SELECT distinct g.name 'Group Name'
		            FROM GroupRoles gr 
		            LEFT JOIN Groups g on gr.GroupId = g._id 
		            LEFT JOIN Role r on gr.RoleId = r._id 
		            WHERE r.Name like 'ORC_Proposal%'
		        ) t1
		
		        LEFT JOIN
		
		        (
		            SELECT g.name 'Group Name', r.Name, 'Yes' 'Title Viewer'
		            FROM GroupRoles gr 
		            LEFT JOIN Groups g on gr.GroupId = g._id 
		            LEFT JOIN Role r on gr.RoleId = r._id 
		            WHERE r.Name = 'ORC_ProposalTitle_Viewer'
		        ) t2
		
		        ON t1.[Group Name] = t2.[Group Name]
		    "]),
		    #"Replaced Value" = Table.ReplaceValue(Source,null,"No",Replacer.ReplaceValue,{"Title Viewer"})
		in
		    #"Replaced Value"
		```
