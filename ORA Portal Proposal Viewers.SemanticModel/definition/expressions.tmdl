expression 'Org Units' =
		let
		    Source = Sql.Database("dbsqlazprd.database.windows.net", "Authorization", [Query="
		    Select distinct 'Department' 'Unit Type', dept_code 'Code', dept_name 'Name'
		        FROM import.Department
		        WHERE loc_code = '4'
		
		    UNION
		
		    Select distinct 'Subdivision' 'Unit Type', sub_div_code 'Code', sub_div_name 'Name'
		        FROM import.Department
		        WHERE loc_code = '4' AND
		        sub_div_code <> ''
		
		    UNION
		
		    Select distinct 'Division' 'Unit Type', div_code 'Code', div_name 'Name'
		        FROM import.Department
		        WHERE loc_code = '4' AND
		        div_code <> ''
		
		    UNION
		
		    Select distinct 'Organizations' 'Unit Type', org_code 'Code', org_name 'Name'
		        FROM import.Department
		        WHERE loc_code = '4' AND
		        org_code <> ''
		
		    UNION
		
		    Select 'Location' as 'Unit Type', '4' as 'Unit Code', 'UCLA' as 'Name'
		    "]),
		    #"Replaced Value" = Table.ReplaceValue(Source,"Location","Global",Replacer.ReplaceText,{"Unit Type"}),
		    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","Organizations","Organization",Replacer.ReplaceText,{"Unit Type"})
		in
		    #"Replaced Value1"
	lineageTag: 2ca8d61e-c2d6-483a-b96e-40a0accbaa8a
