expression 'Roles - ORC Proposal Viewer' =
		/* Find the Roles which have the permission name that contains ORC_Proposal */
		
		let
		    Source = Sql.Database("dbsqlazprd.database.windows.net", "Authorization", [Query="
		        SELECT r._id 'Role ID', r.Name 'Role Name', r.Description 'Role Description'
		        FROM RolePermission rp
		        LEFT join Role r on rp.RoleId = r._id
		        LEFT join Permission p on rp.PermissionId = p._id
		        WHERE p.Name like 'ORC_Proposal%'"]),
		    #"Replaced Value" = Table.ReplaceValue(Source,"_"," ",Replacer.ReplaceText,{"Role Name"}),
		    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","Proposal","Proposal ",Replacer.ReplaceText,{"Role Name"})
		in
		    #"Replaced Value1"
