expression 'User - ORC Proposal Viewer' = ```
		let
		    Source = Sql.Database("dbsqlazprd.database.windows.net", "Authorization", [Query="
		    SELECT t1.Person_ID 'Person ID', t2.[Title Viewer], t3.[Campus User] FROM 
		    (
		        SELECT 
		            a1.Person_ID, 
		            Name 'Permission Name', 
		            first_name, 
		            last_name, 
		            emp_status,
					home_dept_code
		        FROM
		        (
		            SELECT 
		                r._id as RoleId, 
		                r.Name as RoleName, 
		                pr.Person_ID  
		            FROM [dbo].Role r
		            left join [dbo].Personrole pr on r._id = pr.Roleid
		
		            UNION
		
		            SELECT  
		                gr.Roleid, 
		                r.name as RoleName,
		                gm.person_ID  
		            FROM [dbo].[Groups] g
		            LEFT JOIN [dbo].[GroupRoles] gr on g._id = gr.GroupId
		            LEFT JOIN [dbo].[GroupMembers] gm on g._id = gm.GroupId
		            JOIN [dbo].Role r on gr.RoleId = r._id
		        ) a1
		        LEFT JOIN [dbo].RolePermission rp on rp.RoleId = a1.RoleId
		        LEFT JOIN [dbo].permission p on rp.PermissionId = p._id
		        LEFT JOIN import.employee e on e.Person_Id=a1.Person_Id
		        WHERE 
		            p.Name LIKE 'ORC_ProposalTools%' AND
		            emp_status in ('A','N','P') --Active, Leave w/o Pay, Leave w/ Pay
		    ) t1
		
		    LEFT JOIN
		
		    (
		        SELECT 
		            'Yes' 'Title Viewer',
		            a2.Person_ID
		        FROM
		            (
		                SELECT 
		                    r._id as RoleId, 
		                    r.Name as RoleName, 
		                    pr.Person_ID  
		                FROM [dbo].Role r
		                LEFT JOIN [dbo].Personrole pr on r._id = pr.Roleid
		
		                UNION
		
		                SELECT  
		                    gr.Roleid, 
		                    r.name as RoleName,
		                    gm.person_ID  
		                FROM [dbo].[Groups] g
		                LEFT JOIN [dbo].[GroupRoles] gr on g._id = gr.GroupId
		                LEFT JOIN [dbo].[GroupMembers] gm on g._id = gm.GroupId
		                JOIN [dbo].Role r on gr.RoleId = r._id
		            ) a2
		        LEFT JOIN [dbo].RolePermission rp on rp.RoleId = a2.RoleId
		        LEFT JOIN [dbo].permission p on rp.PermissionId = p._id
		        LEFT JOIN import.employee e on e.Person_Id=a2.Person_Id
		        WHERE 
		            p.Name like 'ORC_ProposalTitle%' AND
		            emp_status in ('A','N','P') --Active, Leave w/o Pay, Leave w/ Pay
		
		    ) t2 ON t1.Person_ID = t2.Person_ID
		
			LEFT JOIN
		
			(
				SELECT dept_code, 'Yes' 'Campus User'
				FROM import.Department
				WHERE org_code != '3100' AND loc_code = '4'
		
			) t3 ON t1.home_dept_code = t3.dept_code
		
		"])
		in
		    Source
		
		
		/*
